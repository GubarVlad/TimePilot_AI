# TimePilot AI - Environment Configuration
# Open Agent Hackathon 2026 - Template (Placeholders only)

# Zetaris Unified Semantic Layer (USL) Data Layer
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key

# Meterless Nightshift AI Provider (routes to NVIDIA Nemotron models)
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
METERLESS_MODEL=meterless/auto

# Sample Mode: allows full multi-agent reasoning without requiring local daemons
SAMPLE_MODE=true

# Server Port
PORT=8000
HOST=0.0.0.0

